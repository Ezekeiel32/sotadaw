// TRANSPARENT peak soft-clip for mastering — 2x POLYPHASE OVERSAMPLED tanh.
// Physics: an 8 kHz fundamental's genuine 3rd harmonic (24 kHz) MUST alias at
// 44.1k single-rate — no waveshaping trick can remove it (ADAA measured -47.4
// dBc + a -1 dB top-octave tilt, breaking this fx's "no darkening" contract).
// 2x OS captures the harmonic legitimately at 88.2k and the downsample FIR
// kills it before decimation. 63-tap remez lowpass (pass 18.2k +-0.018 dB,
// -71 dB @ 24k), split into polyphase branches running at BASE rate:
//   up:   u0 = 2*HE(x), u1 = 2*HO(x)     (zero-stuff + filter, per phase)
//   clip: y_i = tanh(drive*u_i)/drive     (unity for small signals)
//   down: v  = HE(y0) + HO(y1@1)          (filter + decimate, phase-exact)
declare name "fx_softclip";
import("stdfaust.lib");

// drive dB: how hard peaks are pushed into the tanh knee (0 = ~transparent).
drive = hslider("drive", 3, 0, 12, 0.1) : ba.db2linear : si.smoo;

clip(x) = ma.tanh(x * drive) / drive;

HE2 = (0.0014493224, -0.0029389454, 0.0040928987, -0.0063390753, 0.0086395097, -0.0107401195, 0.0120501410, -0.0118501245, 0.0092732094, -0.0032937572, -0.0073614869, 0.0245319893, -0.0516440394, 0.0972984913, -0.1933652638, 0.6301972503, 0.6301972503, -0.1933652638, 0.0972984913, -0.0516440394, 0.0245319893, -0.0073614869, -0.0032937572, 0.0092732094, -0.0118501245, 0.0120501410, -0.0107401195, 0.0086395097, -0.0063390753, 0.0040928987, -0.0029389454, 0.0014493224);
HO2 = (-0.0026363710, 0.0013272606, -0.0010161299, -0.0005279349, 0.0032839319, -0.0075693854, 0.0135090345, -0.0210673252, 0.0300148101, -0.0399215043, 0.0501809563, -0.0600669433, 0.0688035344, -0.0756591063, 0.0800394023, 0.9184584632, 0.0800394023, -0.0756591063, 0.0688035344, -0.0600669433, 0.0501809563, -0.0399215043, 0.0300148101, -0.0210673252, 0.0135090345, -0.0075693854, 0.0032839319, -0.0005279349, -0.0010161299, 0.0013272606, -0.0026363710);
HE  = (0.0007246612, -0.0014694727, 0.0020464493, -0.0031695377, 0.0043197549, -0.0053700597, 0.0060250705, -0.0059250623, 0.0046366047, -0.0016468786, -0.0036807435, 0.0122659947, -0.0258220197, 0.0486492457, -0.0966826319, 0.3150986251, 0.3150986251, -0.0966826319, 0.0486492457, -0.0258220197, 0.0122659947, -0.0036807435, -0.0016468786, 0.0046366047, -0.0059250623, 0.0060250705, -0.0053700597, 0.0043197549, -0.0031695377, 0.0020464493, -0.0014694727, 0.0007246612);
HO  = (-0.0013181855, 0.0006636303, -0.0005080649, -0.0002639674, 0.0016419660, -0.0037846927, 0.0067545172, -0.0105336626, 0.0150074051, -0.0199607522, 0.0250904781, -0.0300334717, 0.0344017672, -0.0378295532, 0.0400197012, 0.4592292316, 0.0400197012, -0.0378295532, 0.0344017672, -0.0300334717, 0.0250904781, -0.0199607522, 0.0150074051, -0.0105336626, 0.0067545172, -0.0037846927, 0.0016419660, -0.0002639674, -0.0005080649, 0.0006636303, -0.0013181855);

os2clip(x) = v
with {
    u0 = x : fi.fir(HE2);
    u1 = x : fi.fir(HO2);
    v  = (clip(u0) : fi.fir(HE)) + (clip(u1) : fi.fir(HO) : @(1));
};

process = _, _ : par(i, 2, os2clip);
