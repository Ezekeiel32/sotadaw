 void AudioFileUtils::addBWAVStartToMetadata (juce::StringPairArray& metadata, SampleCount time)
 {
+    // SOTA DAW THE SEAL (app/patches/0002-render-epoch-seal.patch, docs/THE_PHYSICS.md E1):
+    // renders must be byte-stable. SOTADAW_RENDER_EPOCH=<unix-seconds> pins the BWAV
+    // origination stamp; unset = wall clock, behavior unchanged (UI exports keep human time).
+    auto originationTime = juce::Time::getCurrentTime();
+    const auto sealEpoch = juce::SystemStats::getEnvironmentVariable ("SOTADAW_RENDER_EPOCH", {});
+
+    if (sealEpoch.isNotEmpty())
+        originationTime = juce::Time (sealEpoch.getLargeIntValue() * 1000);
+
     metadata.addArray (juce::WavAudioFormat::createBWAVMetadata ({}, "tracktion",
-                                                                 {}, juce::Time::getCurrentTime(),
+                                                                 {}, originationTime,
                                                                  time, {}));
 }
 
