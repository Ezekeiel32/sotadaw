+//==============================================================================
+#if TRACKTION_ENABLE_TIMESTRETCH_SIGNALSMITH
+
+#include "signalsmith-stretch.h"
+
+/** SOTA DAW warp v2 (vendored patch; git truth lives in app/patches/):
+    Signalsmith Stretch adapter. Mirrors the ElastiqueDirect pull shape —
+    getFramesNeeded() requests enough input to fill ~one output block, an
+    AudioFifo absorbs the rate mismatch, and construction/reset primes the
+    stretcher with inputLatency() zeros while discarding outputLatency()
+    frames so the stream starts time-aligned (the library's seek recipe).
+*/
+struct SignalsmithStretcher  : public TimeStretcher::Stretcher
+{
+    SignalsmithStretcher (double sourceSampleRate, int samplesPerBlock, int chans, bool realtime)
+        : samplesPerOutputBuffer (samplesPerBlock), numChannels (chans),
+          outputFifo (chans, samplesPerBlock)
+    {
+        CRASH_TRACER
+        stretch.presetDefault (numChannels, (float) sourceSampleRate, realtime);
+        outputFifo.setSize (numChannels, juce::jmax (getMaxFramesNeeded() * 2, samplesPerBlock * 4));
+        primeAlignment();
+    }
+
+    bool isOk() const override      { return true; }
+
+    void reset() override
+    {
+        stretch.reset();
+        outputFifo.reset();
+        fracCarry = 0.0;
+        hasDoneFinalBlock = false;
+        primeAlignment();
+    }
+
+    bool setSpeedAndPitch (float speedRatio, float semitonesUp) override
+    {
+        // speedRatio 2 = output twice as long => half an input frame per output frame
+        inputPerOutput = 1.0 / speedRatio;
+        stretch.setTransposeSemitones (semitonesUp);
+        return true;
+    }
+
+    int getFramesNeeded() const override
+    {
+        const int shortfall = samplesPerOutputBuffer - outputFifo.getNumReady();
+
+        if (shortfall <= 0)
+            return 0;
+
+        return juce::jlimit (0, getMaxFramesNeeded(),
+                             (int) std::ceil (shortfall * inputPerOutput - fracCarry));
+    }
+
+    int getMaxFramesNeeded() const override
+    {
+        return 8192;    // the SoundTouch adapter's experimentally-derived bound
+    }
+
+    int processData (const float* const* inChannels, int numSamples, float* const* outChannels) override
+    {
+        CRASH_TRACER
+
+        if (numSamples > 0)
+        {
+            const double exactOut = numSamples / inputPerOutput + fracCarry;
+            const int outFrames = (int) exactOut;
+            fracCarry = exactOut - outFrames;
+
+            if (outFrames > 0)
+            {
+                AudioScratchBuffer scratch (numChannels, outFrames);
+                stretch.process (inChannels, numSamples,
+                                 scratch.buffer.getArrayOfWritePointers(), outFrames);
+                jassert (outputFifo.getFreeSpace() >= outFrames);
+                outputFifo.write (scratch.buffer, 0, outFrames);
+            }
+            else    // sub-frame nibble: feed the input, emit nothing yet
+            {
+                AudioScratchBuffer none (numChannels, 1);
+                stretch.process (inChannels, numSamples,
+                                 none.buffer.getArrayOfWritePointers(), 0);
+            }
+        }
+
+        return readOutput (outChannels);
+    }
+
+    int flush (float* const* outChannels) override
+    {
+        CRASH_TRACER
+
+        if (! hasDoneFinalBlock)
+        {
+            hasDoneFinalBlock = true;
+
+            if (const int tail = stretch.outputLatency(); tail > 0)
+            {
+                AudioScratchBuffer scratch (numChannels, tail);
+                stretch.flush (scratch.buffer.getArrayOfWritePointers(), tail);
+                outputFifo.write (scratch.buffer, 0,
+                                  juce::jmin (tail, outputFifo.getFreeSpace()));
+            }
+        }
+
+        return readOutput (outChannels);
+    }
+
+private:
+    signalsmith::stretch::SignalsmithStretch<float> stretch;
+    const int samplesPerOutputBuffer, numChannels;
+    double inputPerOutput = 1.0, fracCarry = 0.0;
+    bool hasDoneFinalBlock = false;
+    AudioFifo outputFifo;
+
+    void primeAlignment()
+    {
+        const int inLat = stretch.inputLatency();
+        const int outLat = stretch.outputLatency();
+        AudioScratchBuffer inZeros (numChannels, juce::jmax (1, inLat));
+        AudioScratchBuffer outScratch (numChannels, juce::jmax (1, outLat));
+        inZeros.buffer.clear();
+        stretch.process (inZeros.buffer.getArrayOfReadPointers(), inLat,
+                         outScratch.buffer.getArrayOfWritePointers(), outLat);
+    }
+
+    int readOutput (float* const* outChannels)
+    {
+        if (const int numReady = outputFifo.getNumReady(); numReady > 0)
+        {
+            const int numToReturn = std::min (numReady, samplesPerOutputBuffer);
+            juce::AudioBuffer<float> outputView (outChannels, numChannels, numToReturn);
+
+            if (! outputFifo.read (outputView, 0))
+                return 0;
+
+            return outputView.getNumSamples();
+        }
+
+        return 0;
+    }
+
+    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (SignalsmithStretcher)
+};
+#endif
+
